# =============================================================================
# Riftbound Competitive Tracker - variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# =============================================================================

# --- Supabase (obligatorio para datos reales) --------------------------------
# Si estas dos variables estan vacias, la app arranca en MODO DEMO con datos de
# ejemplo y las mutaciones quedan deshabilitadas.
NEXT_PUBLIC_SUPABASE_URL=
# Proyectos nuevos: la clave se llama "publishable key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Proyectos antiguos: la misma clave se llamaba "anon key". Puedes usar
# cualquiera de las dos (si defines las dos, gana la anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI Coach (opcional) -----------------------------------------------------
# Elige UN proveedor. Si defines OPENAI_API_KEY se usa OpenAI; si no, y hay
# GEMINI_API_KEY, se usa Gemini. Sin ninguna de las dos, /coach queda desactivado.
# Las claves se usan SOLO en el servidor (route handler /api/coach).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelos de respaldo si el principal falla (lista separada por comas).
OPENAI_FALLBACK_MODELS=

# Gemini usa la API compatible con OpenAI, así que no hace falta SDK extra.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google devuelve 503 "high demand" a menudo en los modelos flash. El coach
# reintenta y, si sigue fallando, prueba estos modelos en orden. Si lo dejas
# vacío se usa la lista por defecto de src/lib/env.ts.
GEMINI_FALLBACK_MODELS=
